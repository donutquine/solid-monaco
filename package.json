{
    "name": "@donutquine/solid-monaco",
    "version": "0.3.0",
    "private": false,
    "description": "Monaco Editor for SolidJS",
    "keywords": [
        "solid"
    ],
    "homepage": "https://github.com/donutquine/solid-monaco#readme",
    "bugs": {
        "url": "https://github.com/donutquine/solid-monaco/issues"
    },
    "license": "MIT",
    "author": "Aleksandr Lesnenko & Danila Schelkov",
    "contributors": [],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/donutquine/solid-monaco.git"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "browser": {},
    "types": "./dist/index.d.mts",
    "typesVersions": {},
    "exports": {
        "solid": {
            "import": "./dist/index.mjs"
        },
        "development": {
            "import": {
                "types": "./dist/index.d.mts"
            }
        },
        "import": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "dev": "vp dev",
        "build": "vp pack --dts",
        "format": "vp fmt --ignore-path .gitignore \"src/**/*.{js,ts,json,css,tsx,jsx}\" \"dev/**/*.{js,ts,json,css,tsx,jsx}\"",
        "lint:types": "tsc --noEmit",
        "prepare": "vp config"
    },
    "dependencies": {
        "@monaco-editor/loader": "^1.4.0"
    },
    "devDependencies": {
        "@solidjs/router": "^0.13.6",
        "@types/node": "^20.16.3",
        "esbuild": "^0.20.2",
        "esbuild-plugin-solid": "^0.5.0",
        "monaco-editor": "^0.48.0",
        "solid-js": "^1.8.22",
        "tsup-preset-solid": "^2.2.0",
        "typescript": "^5.5.4",
        "unplugin-solid": "^3.0.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plugin-solid": "^2.10.2",
        "vite-plus": "1.4.0"
    },
    "peerDependencies": {
        "monaco-editor": "^0.48.0",
        "solid-js": "^1.8.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    }
}
