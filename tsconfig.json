{
    "compilerOptions": {
        // General
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "target": "ESNext",
        // Modules
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        // Paths
        "paths": { "~/*": ["./src/*"] },
        // Type Checking & Safety
        "strict": true,
        "types": ["vite/client"]
    }
}
